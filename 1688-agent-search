#!/bin/sh

set -eu

AS1688_SOURCE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

command -v node >/dev/null 2>&1 || {
    echo "启动失败：需要 Node.js 24 或更高版本" >&2
    exit 1
}
node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 24 ? 0 : 1)' || {
    echo "启动失败：需要 Node.js 24 或更高版本（当前 $(node --version)）" >&2
    exit 1
}

if [ ! -x "$AS1688_SOURCE_DIR/node_modules/.bin/tsc" ]; then
    echo "正在安装开发依赖..." >&2
    (cd "$AS1688_SOURCE_DIR" && npm ci --no-audit --no-fund)
fi

(cd "$AS1688_SOURCE_DIR" && npm run build --silent)
export AGENT_SEARCH_1688_SKILL_ROOT="$AS1688_SOURCE_DIR/skills"
exec node "$AS1688_SOURCE_DIR/dist/cli-entry.js" "$@"
